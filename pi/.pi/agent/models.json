{
  "providers": {
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "$OPENROUTER_API_KEY",
      "api": "openai-completions",
      "modelOverrides": {
        "deepseek/deepseek-v4.1-flash": {
          "compat": {
            "openRouterRouting": {
              "ignore": ["gmicloud", "digitalocean"],
              "sort": { "by": "throughput" },
              "max_price": {
                "prompt": 0.21,
                "completion": 0.85
              },
              "preferred_min_throughput": {
                "p50": 80
              },
              "preferred_max_latency": {
                "p50": 4
              }
            }
          }
        }
      }
    }
  }
}
